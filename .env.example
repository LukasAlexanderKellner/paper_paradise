# Kopiere diese Datei nach .env und trage deine Werte ein. .env wird nicht committet.
# In GitHub Actions werden dieselben Namen als Repository-Secrets angelegt.

# SMTP-Versand (Port 465 = SSL, sonst STARTTLS, z. B. 587)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=newsletter@example.com
SMTP_PASSWORD=

# Empfänger, kommagetrennt. Stehen bewusst nicht in config.toml, damit sie nicht im Repo landen.
NEWSLETTER_RECIPIENTS=du@example.com

# Optional: Absender, überschreibt "sender" aus config.toml (Standard: SMTP_USER)
NEWSLETTER_SENDER=

# Optional: Editorial und "Warum relevant"-Texte per Claude
ANTHROPIC_API_KEY=

# Optional: höheres Rate-Limit für die GitHub-Suche (in Actions automatisch gesetzt)
GITHUB_TOKEN=
