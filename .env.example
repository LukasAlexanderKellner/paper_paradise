# Copy this file to .env and fill in your values. .env is not committed.
# In GitHub Actions, create the same names as repository secrets.

# Brevo delivery ([newsletter] delivery = "brevo" in config.toml): API key from Brevo -> SMTP & API -> API Keys
BREVO_API_KEY=

# SMTP delivery ([newsletter] delivery = "smtp"; port 465 = SSL, otherwise STARTTLS, e.g. 587)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=newsletter@example.com
SMTP_PASSWORD=

# Recipients, comma-separated. Deliberately not in config.toml so they never end up in the repo.
NEWSLETTER_RECIPIENTS=you@example.com

# Optional: sender address, overrides "sender" from config.toml (default: SMTP_USER)
NEWSLETTER_SENDER=

# Optional: summary at the top and "why it matters" texts via Google Gemini
# (key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: higher rate limit for GitHub search (set automatically in Actions)
GITHUB_TOKEN=
