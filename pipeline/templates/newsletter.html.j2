<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>paper_porn Weekly</title>
</head>
<body style="margin:0;padding:0;background:#f4f4f5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#18181b;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f4f5;">
<tr><td align="center" style="padding:24px 12px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:640px;background:#ffffff;border-radius:8px;">
  <tr><td style="padding:28px 28px 8px 28px;">
    <h1 style="margin:0;font-size:24px;line-height:1.3;">paper_porn Weekly</h1>
    <p style="margin:6px 0 0 0;font-size:14px;color:#71717a;">{{ period_start.strftime('%Y-%m-%d') }} – {{ period_end.strftime('%Y-%m-%d') }}</p>
  </td></tr>
{% if glossary %}
  <tr><td style="padding:16px 28px 0 28px;">
    <div style="padding:14px 18px;background:#fafafa;border:1px solid #e4e4e7;border-radius:6px;">
      <p style="margin:0 0 8px 0;font-size:13px;font-weight:600;letter-spacing:0.04em;text-transform:uppercase;color:#71717a;">Glossary</p>
      <ul style="margin:0;padding-left:18px;font-size:13px;line-height:1.5;color:#3f3f46;">
{% for g in glossary %}
        <li style="margin:0 0 4px 0;"><strong>{{ g.term }}</strong> = {{ g.translation }}: {{ g.explanation }}</li>
{% endfor %}
      </ul>
    </div>
  </td></tr>
{% endif %}
{% if headline or summary or highlights %}
  <tr><td style="padding:16px 28px 0 28px;">
    <div style="padding:16px 18px;background:#eff6ff;border-left:4px solid #1d4ed8;border-radius:6px;">
{% if headline %}
      <p style="margin:0 0 8px 0;font-size:16px;font-weight:600;line-height:1.45;">{{ headline }}</p>
{% endif %}
{% if summary %}
      <p style="margin:0;font-size:15px;line-height:1.55;">{{ summary }}</p>
{% endif %}
{% if highlights %}
      <ul style="margin:12px 0 0 0;padding-left:18px;font-size:14px;line-height:1.5;">
{% for h in highlights %}
        <li style="margin:0 0 6px 0;"><a href="{{ h.item.meta.get('abs_url') or h.item.url }}" style="color:#1d4ed8;font-weight:600;text-decoration:none;">{{ h.item.title }}</a>: {{ h.takeaway }}</li>
{% endfor %}
      </ul>
{% endif %}
    </div>
  </td></tr>
{% endif %}
{% for section in sections %}
  <tr><td style="padding:24px 28px 0 28px;">
    <h2 style="margin:0 0 4px 0;font-size:18px;border-bottom:2px solid #e4e4e7;padding-bottom:6px;">{{ section.title }}</h2>
  </td></tr>
{% for item in section["items"] %}
  <tr><td style="padding:14px 28px 0 28px;">
    <a href="{{ item.meta.get('abs_url') or item.url }}" style="font-size:16px;font-weight:600;color:#1d4ed8;text-decoration:none;line-height:1.4;">{{ item.title }}</a>
    <p style="margin:4px 0 0 0;font-size:13px;color:#71717a;">
{% if item.source == 'huggingface' %}▲ {{ item.meta.upvotes }} upvotes{% elif item.source == 'github' %}★ {{ item.meta.stars }} stars · relevance {{ '%.2f'|format(item.score) }}{% elif item.source == 'arxiv' %}{{ item.meta.categories|join(', ') }} · relevance {{ '%.2f'|format(item.score) }}{% elif item.source == 'blogs' %}{{ item.meta.feed }}{% if item.score is not none %} · relevance {{ '%.2f'|format(item.score) }}{% endif %}{% endif %}
{% if item.date %} · {{ item.date.strftime('%Y-%m-%d') }}{% endif %}
{% if item.source == 'arxiv' %} · <a href="{{ item.url }}" style="color:#71717a;">PDF</a>{% endif %}
    </p>
{% if item.why %}
    <p style="margin:6px 0 0 0;font-size:14px;line-height:1.5;"><strong>Why it matters:</strong> {{ item.why }}</p>
{% endif %}
{% if item.summary %}
    <p style="margin:6px 0 0 0;font-size:14px;line-height:1.5;color:#3f3f46;">{{ item.summary|truncate_words }}</p>
{% endif %}
  </td></tr>
{% endfor %}
{% endfor %}
{% if failed_sources %}
  <tr><td style="padding:24px 28px 0 28px;">
    <p style="margin:0;padding:10px 14px;background:#fef3c7;border-radius:6px;font-size:13px;color:#92400e;">Not available in this issue: {{ failed_sources|join(', ') }}</p>
  </td></tr>
{% endif %}
  <tr><td style="padding:24px 28px 28px 28px;">
    <p style="margin:0;font-size:12px;line-height:1.6;color:#a1a1aa;">Generated automatically by paper_porn.
{% if unsubscribe_url %}
      You receive this newsletter because you subscribed to it.
{% endif %}
{% if unsubscribe_url or imprint_url %}
      <br>
{% if unsubscribe_url %}
      <a href="{{ unsubscribe_url }}" style="color:#71717a;">Unsubscribe</a>
{% endif %}
{% if unsubscribe_url and imprint_url %} · {% endif %}
{% if imprint_url %}
      <a href="{{ imprint_url }}" style="color:#71717a;">Imprint</a>
{% endif %}
{% endif %}
    </p>
  </td></tr>
</table>
</td></tr>
</table>
</body>
</html>
